---
interface Props {
	description: string;
	isHome?: boolean;
	title: string;
}

const { description, isHome = false, title } = Astro.props;
const site = Astro.site ?? new URL('https://swift95.dimasike.com');
const canonical = new URL(Astro.url.pathname, site);
const home = new URL('/', site);
const socialImage = new URL('/social/swift95-social.png', site);
const repository = 'https://github.com/dimamishchenko/swift95';
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
	{
		'@type': 'ListItem',
		position: 1,
		name: 'Swift95',
		item: home.href,
	},
	...pathSegments.map((segment, index) => ({
		'@type': 'ListItem',
		position: index + 2,
		name:
			index === pathSegments.length - 1
				? title
				: segment
						.split('-')
						.map((word) => `${word.charAt(0).toUpperCase()}${word.slice(1)}`)
						.join(' '),
		item: new URL(`/${pathSegments.slice(0, index + 1).join('/')}/`, site).href,
	})),
];
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${home.href}#website`,
			url: home.href,
			name: 'Swift95',
			description:
				'A Windows 95-inspired SwiftUI component kit for iOS, iPadOS, and macOS.',
			inLanguage: 'en',
		},
		...(isHome
			? [
					{
						'@type': 'SoftwareSourceCode',
						'@id': `${home.href}#software`,
						name: 'Swift95',
						description,
						url: canonical.href,
						codeRepository: repository,
						programmingLanguage: 'Swift',
						runtimePlatform: ['iOS 18+', 'iPadOS 18+', 'macOS 15+'],
						license: `${repository}/blob/main/LICENSE`,
						image: socialImage.href,
						isPartOf: { '@id': `${home.href}#website` },
					},
				]
			: [
					{
						'@type': 'TechArticle',
						'@id': `${canonical.href}#article`,
						headline: title,
						description,
						url: canonical.href,
						inLanguage: 'en',
						about: { '@id': `${home.href}#software` },
						isPartOf: { '@id': `${home.href}#website` },
					},
					{
						'@type': 'BreadcrumbList',
						itemListElement: breadcrumbItems,
					},
				]),
	],
};
---

<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
<meta name="theme-color" content="#000080" />
<link rel="apple-touch-icon" sizes="180x180" href="/swift95-touch-icon.png" />
<meta property="og:image" content={socialImage.href} />
<meta property="og:image:secure_url" content={socialImage.href} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Swift95 documentation homepage with an animated ASCII void" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage.href} />
<meta name="twitter:image:alt" content="Swift95 documentation homepage with an animated ASCII void" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
