{
  "name": "swift95-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run check && astro build && npm run llms:generate && npm run llms:validate && npm run seo:validate",
    "check": "npm run test && astro check",
    "llms:generate": "node scripts/generate-llms.mjs generate",
    "llms:validate": "node scripts/generate-llms.mjs validate",
    "seo:validate": "node scripts/validate-site.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/starlight": "^0.41.11",
    "@react95/core": "^10.0.2",
    "astro": "^7.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "esbuild": "^0.28.2",
    "hast-util-select": "^6.0.4",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-remove": "^4.0.0"
  },
  "overrides": {
    "@expressive-code/core": {
      "postcss-nested": "^7.0.2"
    }
  }
